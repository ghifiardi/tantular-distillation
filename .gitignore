# Corpora and weights never belong in git — HF hosts those.
data/raw/
data/promoted/
adapters/
*.jsonl
!prompts/*.jsonl
*.gguf
*.safetensors

__pycache__/
*.pyc
.venv/
.pytest_cache/

# Secrets never belong in the repo. The gateway key is read from
# TANTULAR_GATEWAY_KEY at runtime; if you keep it in a file, keep it here.
.env
.env.*
*.key
secrets/
